{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "node": "24.21.0",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://str.valera.ws"
      }
    },
    "testing": {
      "extends": "production"
    }
  },
  "submit": {
    "production": {},
    "testing": {
      "android": {
        "track": "internal"
      },
      "ios": {}
    }
  }
}
