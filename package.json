{
    "name": "strava-events-app",
    "version": "1.0.0",
    "description": "Simple app to fetch Strava club events and show them in a calendar",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
        "start": "node --env-file-if-exists=.env src/server.js",
        "dev": "node --env-file-if-exists=.env --watch src/server.js",
        "test": "node --experimental-vm-modules --test tests/baseline/*.test.js tests/regressions/*.test.js",
        "test:baseline": "node --experimental-vm-modules --test tests/baseline/*.test.js",
        "test:regressions": "node --experimental-vm-modules --test tests/regressions/*.test.js",
        "test:mongodb": "node --experimental-vm-modules --test tests/integration/*.test.js",
        "build": "vite build --config frontend/vite.config.js",
        "dev:frontend": "vite --config frontend/vite.config.js",
        "dev:mock": "node --watch prototypes/calendar/backend/server.js",
        "pretest": "npm run build"
    },
    "dependencies": {
        "connect-mongo": "^6.0.0",
        "express": "^5.2.1",
        "express-session": "^1.19.0",
        "mongodb": "^7.7.0",
        "node-fetch": "^3.3.2",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "keywords": [
        "strava",
        "events",
        "calendar"
    ],
    "author": "",
    "license": "BSD-2-Clause",
    "engines": {
        "node": ">=24.0.0 <25"
    },
    "devDependencies": {
        "vite": "8.3.4"
    }
}
